# .gitignore

# 个人数据
profiles/me-default/
profiles/test-*/
profiles/*-private/

# 原始资料（如果从旧版本迁移）
debate/
*.docx
*.pdf
*.pptx
*.ppt
*.doc
*.mp4
*.mp3
*.m4a
*.flv
*.wav
*.zip
*.rar
*.7z

# 归档
archive/

# 缓存和临时文件
.cache/
*.tmp
*.log
*~
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
*.egg-info/

# Node
node_modules/
package-lock.json
yarn.lock

# 构建输出
dist/
build/
*.egg

# 测试覆盖
.coverage
htmlcov/
.pytest_cache/
tests/

# 系统文件
*.bak
*.orig

# 临时工作文件
convert_docx.py
extract_docx.sh
*.汇报.md
增量任务完成报告.md

# 测试中的具体稿件（保留测试框架）
tests/*/before/*.md
tests/*/after/*.md
!tests/*/topics.md
!tests/*/*-report.md
!tests/*/final-verdict.md

# 本地配置
config.local.yaml
.env
.env.local

# 发布准备文件（本地）
release-audit.md
REFACTOR-PLAN.md
RELEASE-COMPLETE.md
